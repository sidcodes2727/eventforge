// ============================================
// Prisma Schema — Idempotent Event Processing System
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────

enum EventStatus {
  pending
  processing
  processed
  failed
  dead
}

enum EventPriority {
  low
  medium
  high
  critical
}

enum AlertSeverity {
  info
  warning
  error
  critical
}

// ── Users ────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apiKeys ApiKey[]

  @@map("users")
}

// ── Events ───────────────────────────────────────────

model Event {
  id                  String        @id @default(uuid()) @db.Uuid
  idempotencyKey      String        @unique @map("idempotency_key") @db.VarChar(255)
  type                String        @db.VarChar(100)
  payload             Json          @default("{}") @db.JsonB
  metadata            Json          @default("{}") @db.JsonB
  status              EventStatus   @default(pending)
  priority            EventPriority @default(medium)
  retryCount          Int           @default(0) @map("retry_count")
  maxRetries          Int           @default(5) @map("max_retries")
  processingStartedAt DateTime?     @map("processing_started_at")
  processedAt         DateTime?     @map("processed_at")
  processingTimeMs    Int?          @map("processing_time_ms")
  errorMessage        String?       @map("error_message") @db.Text
  errorStack          String?       @map("error_stack") @db.Text
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  retryLogs        RetryLog[]
  idempotencyStore IdempotencyStore?
  alerts           Alert[]

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([status, priority])
  @@map("events")
}

// ── Retry Logs ───────────────────────────────────────

model RetryLog {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  attemptNumber Int      @map("attempt_number")
  attemptedAt   DateTime @default(now()) @map("attempted_at")
  error         String   @db.Text
  nextRetryAt   DateTime? @map("next_retry_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("retry_logs")
}

// ── Idempotency Store ────────────────────────────────

model IdempotencyStore {
  key             String   @id @db.VarChar(255)
  eventId         String   @unique @map("event_id") @db.Uuid
  responsePayload Json     @default("{}") @map("response_payload") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("idempotency_store")
}

// ── API Keys ─────────────────────────────────────────

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(255)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  keyPrefix  String    @map("key_prefix") @db.VarChar(12)
  permissions Json     @default("{}") @db.JsonB
  rateLimit  Int       @default(100) @map("rate_limit")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

// ── Alerts ───────────────────────────────────────────

model Alert {
  id         String        @id @default(uuid()) @db.Uuid
  eventId    String?       @map("event_id") @db.Uuid
  type       String        @db.VarChar(100)
  message    String        @db.Text
  severity   AlertSeverity @default(info)
  resolvedAt DateTime?     @map("resolved_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([severity])
  @@index([createdAt])
  @@map("alerts")
}
